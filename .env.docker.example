# Copie para .env.docker e ajuste os valores:
# cp .env.docker.example .env.docker   (Windows: copy .env.docker.example .env.docker)
#
# ATENÇÃO: evite o caractere "$" nos valores — o Compose interpreta "$VAR"
# como interpolação de variável. Se precisar usar "$", escape como "$$".

# Django — gere uma chave forte e única (ex.: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())")
SECRET_KEY=troque-por-uma-chave-secreta-forte
DEBUG=True

# Storage S3 (serviço "minio" do docker-compose.yml)
AWS_S3_ENDPOINT_URL=http://minio:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_STORAGE_BUCKET_NAME=home-care-media
AWS_S3_REGION_NAME=us-east-1
AWS_S3_SIGNATURE_VERSION=s3v4
AWS_DEFAULT_ACL=private
AWS_QUERYSTRING_AUTH=False
