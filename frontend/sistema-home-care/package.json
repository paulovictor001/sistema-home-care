{
  "name": "sistema-home-care",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test:assessments": "node --test tests/assessments.test.mjs",
    "test:patients": "node --test tests/patients.test.mjs",
    "test:care-scales:unit": "node --test tests/careScales.test.mjs",
    "test:care-scales:e2e": "node tests/careScales.browser.mjs",
    "test:care-scales": "npm run test:care-scales:unit && npm run build && npm run test:care-scales:e2e",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "playwright": "^1.65.1",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
